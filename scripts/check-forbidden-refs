#!/usr/bin/env python3
"""Contrôle des références interdites dans les fichiers versionnés.

Les motifs interdits ne vivent jamais dans le dépôt. Deux sources, dans
l'ordre :
  1. la variable d'environnement PIGMA_FORBIDDEN_REFS (motifs séparés par
     des points-virgules, expressions régulières) ;
  2. le fichier local non versionné config/forbidden-refs.local (un motif
     par ligne ; lignes vides et commentaires ignorés).

Sans motif disponible, le contrôle ne peut rien examiner : il réussit en
affichant un avertissement — à distinguer d'un vrai vert. Le contenu des
fichiers n'est jamais recopié dans la sortie : ni le motif ni la ligne
concernée ne s'affichent.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LOCAL_FILE = ROOT / "config" / "forbidden-refs.local"


def load_patterns():
    """Charge les motifs depuis l'environnement ou le fichier local."""
    from_env = os.environ.get("PIGMA_FORBIDDEN_REFS", "").strip()
    if from_env:
        return [part.strip() for part in from_env.split(";") if part.strip()]
    if LOCAL_FILE.is_file():
        return [line.strip() for line in
                LOCAL_FILE.read_text(encoding="utf-8").splitlines()
                if line.strip() and not line.startswith("#")]
    return []


def versioned_files():
    """Fichiers versionnés ou ajoutés, hors fichiers ignorés."""
    try:
        output = subprocess.run(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
            cwd=ROOT, capture_output=True, text=True, check=True)
        return [ROOT / name for name in output.stdout.splitlines() if name]
    except (OSError, subprocess.CalledProcessError):
        # Hors dépôt Git : balayage simple avec exclusions de répertoires.
        excluded = {".git", ".gradle", "build"}
        return [path for path in ROOT.rglob("*")
                if path.is_file() and excluded.isdisjoint(path.parts)]


def main():
    patterns = load_patterns()
    if not patterns:
        print("check-forbidden-refs : aucun motif fourni "
              "(PIGMA_FORBIDDEN_REFS ou config/forbidden-refs.local) ; "
              "contrôle sans effet.")
        return 0
    compiled = [re.compile(pattern, re.IGNORECASE) for pattern in patterns]
    files = versioned_files()
    violations = 0
    for path in files:
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        for line_number, content in enumerate(text.split("\n"), start=1):
            for regex in compiled:
                if regex.search(content):
                    print("check-forbidden-refs : " + str(path) + ":" + str(line_number)
                          + " : référence interdite (motif non affiché)")
                    violations += 1
    if violations:
        print("check-forbidden-refs : " + str(violations)
              + " référence(s) interdite(s)")
        return 1
    print("check-forbidden-refs : OK (" + str(len(files))
          + " fichier(s) examiné(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main())
